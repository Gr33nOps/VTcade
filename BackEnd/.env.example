# Copy to .env and fill in real values. Never commit .env.

PORT=5000
NODE_ENV=development

FRONTEND_URL=http://localhost:3000

# How many proxies sit in front of this server, for reading the client address
# out of X-Forwarded-For. 4 in production: Vercel's /api rewrite plus Render's
# own router. Set too low and every request resolves to the proxy, which turns
# the per address rate limiter into one shared bucket for the whole internet.
# Locally there is no proxy at all, so 0.
# Verify with GET /api/admin/diagnostics/ip after any hosting change.
TRUST_PROXY_HOPS=0

# Supabase project settings -> API
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your_publishable_anon_key

# Supabase project settings -> API -> service_role (secret).
# Bypasses Row Level Security. Server side only, never expose to the frontend.
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key

# Admin panel credentials
ADMIN_USERNAME=admin
ADMIN_PASSWORD=choose_a_strong_password

# Secret used to sign short-lived admin session tokens.
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
ADMIN_JWT_SECRET=generate_a_long_random_string
ADMIN_TOKEN_TTL=2h
